  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pending_winnings_release_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "release_pending_winnings": {
          "call": "invoke_backend_function",
          "with": {
