{
  "name": "Post-Settlement Integrity",
  "description": "After a Match is fully settled and visible to players, independently runs integrity rules and Stockfish screening.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Match",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "post_settlement_integrity",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_post_settlement_jobs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runPostSettlementJobs",
            "args": {
              "matchId": "${ .trigger.entity_id }",
              "gameId": "${ .trigger.data.game_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run Post-Settlement Jobs",
            "description": "Run integrity and Stockfish work independently of financial settlement"
          }
        }
      }
    ]
  }
}