{
  "name": "Rating Finalization Sweep",
  "description": "Every 15 minutes, retries eligible ratings. Free games qualify at completion. Money games retain the 24-hour review window and released-payout requirement. Unresolved reviews remain excluded.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "7,22,37,52 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rating_finalization_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_eligible_ratings": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processEligibleRatings",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Process Final Ratings",
            "description": "Apply eligible Glicko-2 ratings; free results have no timed waiting period"
          }
        }
      }
    ]
  }
}