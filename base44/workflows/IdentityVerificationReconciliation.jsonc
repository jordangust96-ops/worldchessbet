{
  "name": "Hosted Bank Verification Reconciliation Sweep",
  "description": "Every 30 minutes, re-syncs player eligibility against the webhook-evidenced Seamless hosted Plaid funding source, downgrading eligibility if they disagree.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hosted_bank_verification_reconciliation_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reconcile_bank_verification": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconcileIdentityVerification",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Reconcile Hosted Bank Verification",
            "description": "Re-sync player eligibility against webhook-verified SeamlessBankAccount records; downgrade on drift"
          }
        }
      }
    ]
  }
}