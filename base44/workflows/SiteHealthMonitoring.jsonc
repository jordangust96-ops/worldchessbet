{
  "name": "Site Health Monitoring",
  "description": "Every 15 minutes, collect bounded read-only availability, connection and capacity observations. Send incident/recovery alerts and a 9 AM Detroit daily health digest to hello@worldchessbet.com. No transactions or provider evaluations.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "3,18,33,48 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "site_health_monitoring",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "collect_site_health": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runSiteHealthChecks",
            "args": {
              "persist": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Collect site health",
            "description": "Observe health, save bounded history, and send authorized health alerts."
          }
        }
      }
    ]
  }
}
