{
  "name": "Settlement Recovery Sweep",
  "description": "Every minute, retries completed games whose server-side settlement workflow was missed or safely recovers an abandoned pre-ledger settlement lease.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "* * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "settlement_recovery_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reconcile_pending_settlements": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconcilePendingSettlements",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Reconcile Pending Settlements",
            "description": "Recover server-side settlement independently of player browser sessions"
          }
        }
      }
    ]
  }
}