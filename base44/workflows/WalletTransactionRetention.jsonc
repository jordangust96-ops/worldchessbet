{
  "name": "Wallet Transaction Retention Enforcement",
  "description": "Daily at 11:15 UTC, stamp or extend minimum two-year retention deadlines for legacy transactions and later activity. New transactions receive an initial deadline at creation.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 11 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "wallet_transaction_retention_enforcement",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enforce_wallet_transaction_retention": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforceWalletTransactionRetention",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Enforce Wallet Transaction Retention",
            "description": "Stamp or extend the two-year retention deadline without deleting records"
          }
        }
      }
    ]
  }
}