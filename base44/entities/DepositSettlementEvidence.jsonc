{
  "name": "DepositSettlementEvidence",
  "type": "object",
  "properties": {
    "wallet_transaction_id": {
      "type": "string"
    },
    "provider_reference_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "settlement",
        "return"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "matched",
        "mismatch"
      ]
    },
    "pricing_version": {
      "type": "string"
    },
    "bank_debit": {
      "type": "number"
    },
    "processing_fee": {
      "type": "number"
    },
    "net_received": {
      "type": "number"
    },
    "processing_fee_retained": {
      "type": "number"
    },
    "return_fee": {
      "type": "number"
    },
    "additional_cash_debit": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "enum": [
        "seamless_statement",
        "seamless_support"
      ]
    },
    "evidence_reference": {
      "type": "string",
      "maxLength": 1000
    },
    "recorded_by": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_key": {
      "type": "string"
    },
    "retention_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "wallet_transaction_id",
    "provider_reference_id",
    "kind",
    "result",
    "pricing_version",
    "source",
    "evidence_reference",
    "recorded_by",
    "recorded_at",
    "evidence_key",
    "retention_until"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}