{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "deposit",
        "withdrawal",
        "wager_lock",
        "wager_refund",
        "payout",
        "wager_forfeit",
        "service_fee_charge",
        "service_fee_refund",
        "withdrawal_fee"
      ]
    },
    "amount": {
      "type": "number"
    },
    "match_id": {
      "type": "string",
      "description": "Related match ID if applicable"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "reversed",
        "review_required"
      ],
      "default": "completed"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "maxLength": 3,
      "description": "ISO currency code for this transaction."
    },
    "direction": {
      "type": "string",
      "enum": [
        "credit",
        "debit",
        "reserve",
        "release",
        "internal"
      ],
      "description": "Normalized movement direction from the participant's perspective."
    },
    "correlation_id": {
      "type": "string",
      "description": "Stable trace key across user, match, game, ledger, dispute, and future provider records."
    },
    "ledger_group_id": {
      "type": "string",
      "description": "Balanced Internal Ledger group posted for this transaction."
    },
    "source_event": {
      "type": "string",
      "maxLength": 128,
      "description": "Server event that created the transaction."
    },
    "initiating_actor": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "administrator"
      ]
    },
    "initiating_actor_id": {
      "type": "string",
      "description": "Internal actor ID; visible only to administrators.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp when the internal ledger posting completed."
    },
    "integration_status": {
      "type": "string",
      "enum": [
        "internal_complete",
        "unrouted",
        "pending",
        "reserved",
        "submitting",
        "submitted",
        "uncertain",
        "settled",
        "failed",
        "reversed"
      ],
      "default": "internal_complete",
      "description": "Provider-neutral integration state. External routing is added only after a partner is selected."
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 255,
      "description": "Stable deduplication key for future provider requests and webhook reconciliation.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "schema_version": {
      "type": "integer",
      "default": 1,
      "minimum": 1
    }
  },
  "required": [
    "user_id",
    "type",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}