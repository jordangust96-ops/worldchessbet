{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "deposit",
        "withdrawal",
        "wager_lock",
        "wager_refund",
        "payout",
        "wager_forfeit",
        "service_fee_charge",
        "service_fee_refund",
        "withdrawal_fee",
        "admin_reversal"
      ]
    },
    "amount": {
      "type": "number"
    },
    "match_id": {
      "type": "string",
      "description": "Related match ID if applicable"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "reversed",
        "review_required"
      ],
      "default": "completed"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "maxLength": 3,
      "description": "ISO currency code for this transaction."
    },
    "direction": {
      "type": "string",
      "enum": [
        "credit",
        "debit",
        "reserve",
        "release",
        "internal"
      ],
      "description": "Normalized movement direction from the participant's perspective."
    },
    "correlation_id": {
      "type": "string",
      "description": "Stable trace key across user, match, game, ledger, dispute, and future provider records."
    },
    "ledger_group_id": {
      "type": "string",
      "description": "Balanced Internal Ledger group posted for this transaction."
    },
    "source_event": {
      "type": "string",
      "maxLength": 128,
      "description": "Server event that created the transaction."
    },
    "initiating_actor": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "administrator"
      ]
    },
    "initiating_actor_id": {
      "type": "string",
      "description": "Internal actor ID; visible only to administrators.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp when the internal ledger posting completed."
    },
    "integration_status": {
      "type": "string",
      "enum": [
        "internal_complete",
        "unrouted",
        "pending",
        "reserved",
        "submitting",
        "submitted",
        "uncertain",
        "settled",
        "failed",
        "reversed"
      ],
      "default": "internal_complete",
      "description": "Provider-neutral integration state. External routing is added only after a partner is selected."
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 255,
      "description": "Stable deduplication key for future provider requests and webhook reconciliation.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "schema_version": {
      "type": "integer",
      "default": 1,
      "minimum": 1
    },
    "payout_hold_status": {
      "type": "string",
      "enum": [
        "held",
        "released",
        "consumed",
        "void"
      ],
      "description": "Only meaningful for type 'payout'. Set at creation to 'held': the winner's payout is credited into Held, not Available, Balance pending the 24-hour contest report window. 'released' once releasePendingWinnings (no report filed) or an admin resolving a filed report (manageDisputeCase, non-reversing resolution) moves it to Available Balance. 'consumed' if an admin's contest_reversed/contest_voided resolution debited it directly out of Held Balance instead. Absent on transactions created before this hold existed \u2014 those were released immediately at settlement, the prior behavior."
    },
    "payout_release_at": {
      "type": "string",
      "format": "date-time",
      "description": "Only meaningful for type 'payout' with payout_hold_status 'held'. The earliest time releasePendingWinnings may release this payout to Available Balance \u2014 24 hours after settlement, matching the contest report deadline. Never released before this time, and never while a DisputeCase or open Fair Play / settlement integrity flag exists for the match."
    }
  },
  "required": [
    "user_id",
    "type",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}