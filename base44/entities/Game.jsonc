{
  "name": "Game",
  "properties": {
    "black_disconnected_at": {
      "description": "Server observation time when Black's game heartbeat became stale. The reconnect timer starts conservatively here and clears on a fresh heartbeat.",
      "format": "date-time",
      "type": "string"
    },
    "black_disconnect_policy_version": {
      "description": "Policy version attached to Black's current server-observed disconnect. Older markers receive a fresh reconnect window before they can affect an outcome.",
      "type": "string"
    },
    "black_focus_loss_count": {
      "default": 0,
      "description": "Number of distinct focus-loss periods recorded for Black. Supporting telemetry only.",
      "type": "number"
    },
    "black_focus_lost_at": {
      "description": "Server timestamp of Black's active browser focus loss. Cleared when focus returns; audit-only.",
      "format": "date-time",
      "type": "string"
    },
    "black_last_seen_at": {
      "description": "Server timestamp of Black's most recent gameHeartbeat call.",
      "format": "date-time",
      "type": "string"
    },
    "black_reconnected_at": {
      "description": "Server timestamp of Black's most recent reconnection after a recorded disconnect, for audit purposes.",
      "format": "date-time",
      "type": "string"
    },
    "black_time_ms": {
      "description": "Black's remaining clock time in milliseconds, authoritative server value",
      "type": "number"
    },
    "black_total_disconnected_ms": {
      "default": 0,
      "description": "Cumulative time Black has spent disconnected across the game, in milliseconds. Audit-only \u2014 never used to adjust clocks or outcomes.",
      "type": "number"
    },
    "black_total_focus_lost_ms": {
      "default": 0,
      "description": "Cumulative milliseconds Black's game tab was not focused. Supporting telemetry only.",
      "type": "number"
    },
    "completed_at": {
      "description": "Set when the game officially ends",
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "description": "Optional description",
      "maxLength": 1000,
      "type": "string"
    },
    "disconnect_timeout_candidate_at": {
      "description": "Server timestamp for the additional heartbeat confirmation interval after the reconnect window expires.",
      "format": "date-time",
      "type": "string"
    },
    "disconnect_timeout_candidate_color": {
      "description": "Side awaiting a final fresh-heartbeat check before a disconnect timeout can be recorded.",
      "enum": [
        "white",
        "black"
      ],
      "type": "string"
    },
    "draw_offered_by": {
      "description": "User ID of the player who currently has an open draw offer pending, empty/null when there is none",
      "type": "string"
    },
    "end_reason": {
      "description": "Authoritative reason the game ended, set server-side by whichever function completed it. Never inferred client-side.",
      "enum": [
        "checkmate",
        "resignation",
        "timeout",
        "disconnect_timeout",
        "draw_agreement",
        "stalemate",
        "threefold_repetition",
        "insufficient_material",
        "fifty_move_rule",
        "timeout_vs_insufficient_material"
      ],
      "type": "string"
    },
    "fen": {
      "default": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
      "description": "Current board position in standard FEN notation",
      "type": "string"
    },
    "focus_log": {
      "description": "Browser focus/visibility events captured during an active game. Supporting forensic telemetry only \u2014 never used to change clocks, moves, or outcomes.",
      "items": {
        "properties": {
          "color": {
            "enum": [
              "w",
              "b"
            ],
            "type": "string"
          },
          "event_type": {
            "enum": [
              "hidden",
              "visible",
              "blur",
              "focus"
            ],
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "increment_ms": {
      "default": 0,
      "description": "Increment in milliseconds added to a player's clock after their move",
      "type": "number"
    },
    "launch_epoch": {
      "default": 2,
      "description": "Production data generation. Games from launch onward use epoch 2; earlier pre-launch history is left unset so it stays gated out of every live gameplay path. Must remain declared: every gameplay function gates on Number(game.launch_epoch) !== 2, and undeclared properties are silently dropped on write.",
      "minimum": 2,
      "type": "integer"
    },
    "match_id": {
      "description": "ID of the Match this game belongs to",
      "type": "string"
    },
    "move_log": {
      "description": "Per-move audit trail \u2014 one entry appended per ply by submitMove. Source of the Contest Record's complete move history with per-move timestamps.",
      "items": {
        "properties": {
          "color": {
            "enum": [
              "w",
              "b"
            ],
            "type": "string"
          },
          "fen_after": {
            "type": "string"
          },
          "ply": {
            "type": "number"
          },
          "remaining_ms": {
            "type": "number"
          },
          "san": {
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "pgn": {
      "description": "Complete move history in PGN notation, authoritative game record",
      "type": "string"
    },
    "player1_id": {
      "description": "White participant ID, copied from the authoritative Match for participant-scoped reads",
      "type": "string"
    },
    "player2_id": {
      "description": "Black participant ID, copied from the authoritative Match for participant-scoped reads",
      "type": "string"
    },
    "result": {
      "default": "unfinished",
      "enum": [
        "white_win",
        "black_win",
        "draw",
        "unfinished"
      ],
      "type": "string"
    },
    "started_at": {
      "description": "Set when the first legal move is made",
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "waiting",
      "description": "Status of the chess game itself, not the financial match",
      "enum": [
        "waiting",
        "active",
        "completed",
        "abandoned"
      ],
      "type": "string"
    },
    "turn_started_at": {
      "description": "Server timestamp when the current side-to-move's clock started ticking",
      "format": "date-time",
      "type": "string"
    },
    "white_disconnected_at": {
      "description": "Server observation time when White's game heartbeat became stale. The reconnect timer starts conservatively here and clears on a fresh heartbeat.",
      "format": "date-time",
      "type": "string"
    },
    "white_disconnect_policy_version": {
      "description": "Policy version attached to White's current server-observed disconnect. Older markers receive a fresh reconnect window before they can affect an outcome.",
      "type": "string"
    },
    "white_focus_loss_count": {
      "default": 0,
      "description": "Number of distinct focus-loss periods recorded for White. Supporting telemetry only.",
      "type": "number"
    },
    "white_focus_lost_at": {
      "description": "Server timestamp of White's active browser focus loss. Cleared when focus returns; audit-only.",
      "format": "date-time",
      "type": "string"
    },
    "white_last_seen_at": {
      "description": "Server timestamp of White's most recent gameHeartbeat call. Used exclusively to detect disconnection \u2014 never to grant extra thinking time.",
      "format": "date-time",
      "type": "string"
    },
    "white_reconnected_at": {
      "description": "Server timestamp of White's most recent reconnection after a recorded disconnect, for audit purposes.",
      "format": "date-time",
      "type": "string"
    },
    "white_time_ms": {
      "description": "White's remaining clock time in milliseconds, authoritative server value",
      "type": "number"
    },
    "white_total_disconnected_ms": {
      "default": 0,
      "description": "Cumulative time White has spent disconnected across the game, in milliseconds. Audit-only \u2014 never used to adjust clocks or outcomes.",
      "type": "number"
    },
    "white_total_focus_lost_ms": {
      "default": 0,
      "description": "Cumulative milliseconds White's game tab was not focused. Supporting telemetry only.",
      "type": "number"
    },
    "winner_id": {
      "description": "User ID of the winner, null for draws or unfinished games",
      "type": "string"
    },
    "play_mode": {
      "type": "string",
      "enum": [
        "money",
        "free"
      ],
      "default": "money",
      "description": "Server-owned play mode. Free games have zero entry, service fee, and money award. Legacy records are money play.",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "match_id",
    "status"
  ],
  "rls": {
    "create": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.player1_id": "{{user.id}}"
        },
        {
          "data.player2_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false
  },
  "type": "object"
}