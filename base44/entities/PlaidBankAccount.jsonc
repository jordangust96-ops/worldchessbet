{
  "name": "PlaidBankAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "account_mask": {
      "type": "string"
    },
    "plaid_access_token": {
      "type": "string",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "plaid_item_id": {
      "type": "string",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "linked",
        "revoked",
        "error"
      ],
      "default": "linked"
    },
    "linked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "account_id",
    "plaid_access_token",
    "plaid_item_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}