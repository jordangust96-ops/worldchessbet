{
  "name": "LedgerEntry",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User this entry belongs to (only set for user_account rows)"
    },
    "match_id": {
      "type": "string",
      "description": "Related Match/contest ID, if applicable"
    },
    "wallet_transaction_id": {
      "type": "string",
      "description": "Related WalletTransaction ID, if applicable"
    },
    "ledger_account": {
      "type": "string",
      "enum": [
        "user_account",
        "contest_clearing",
        "platform_revenue",
        "suspense",
        "settlement",
        "withdrawal_reserve",
        "settlement_reconciliation_adjustment"
      ],
      "description": "Which internal ledger account this row posts to"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "deposit",
        "withdrawal",
        "match_entry",
        "match_release",
        "match_settlement",
        "settlement_reconciliation",
        "platform_fee",
        "refund",
        "admin_adjustment",
        "reversal",
        "investigation_hold",
        "investigation_hold_release"
      ]
    },
    "debit_amount": {
      "type": "number",
      "default": 0
    },
    "credit_amount": {
      "type": "number",
      "default": 0
    },
    "resulting_available_balance": {
      "type": "number",
      "description": "User's available balance after this entry (user_account rows only)"
    },
    "resulting_held_balance": {
      "type": "number",
      "description": "User's held balance after this entry (user_account rows only)"
    },
    "resulting_total_balance": {
      "type": "number",
      "description": "Resulting balance of the account this row posts to \u2014 available+held for user_account rows, or the running balance for system accounts"
    },
    "initiating_actor": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "administrator"
      ],
      "description": "Who/what triggered this ledger entry"
    },
    "initiating_actor_id": {
      "type": "string",
      "description": "ID of the user or admin who triggered this entry, if applicable"
    },
    "trigger_event": {
      "type": "string",
      "description": "Short label for the event that produced this entry, e.g. 'deposit', 'match_settlement'"
    },
    "external_reference_type": {
      "type": "string",
      "enum": [
        "provider_authorization",
        "provider_payment",
        "provider_transfer",
        "provider_payout",
        "provider_refund",
        "provider_reversal",
        "provider_dispute",
        "finix_transaction",
        "match",
        "withdrawal",
        "deposit",
        "none"
      ],
      "default": "none"
    },
    "external_reference_id": {
      "type": "string",
      "description": "ID of the external reference (Finix transaction, withdrawal, deposit, etc.)"
    },
    "ledger_group_id": {
      "type": "string",
      "description": "Groups together the balanced set of entries created for a single financial event"
    },
    "operation_id": {
      "type": "string",
      "description": "Stable logical financial operation identifier. New ledger rows are immutable and unique by operation_id plus leg_index."
    },
    "leg_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Deterministic zero-based identity of this leg within its operation."
    },
    "available_delta": {
      "type": "number",
      "description": "Authoritative available-balance delta for user_account legs."
    },
    "held_delta": {
      "type": "number",
      "description": "Authoritative held-balance delta for user_account legs."
    },
    "total_wagered_delta": {
      "type": "number"
    },
    "total_won_delta": {
      "type": "number"
    },
    "total_deposited_delta": {
      "type": "number"
    },
    "total_withdrawn_delta": {
      "type": "number"
    },
    "correlation_id": {
      "type": "string",
      "description": "Stable trace key across participant, match, game, wallet transaction, dispute, and provider records."
    },
    "game_id": {
      "type": "string",
      "description": "Related authoritative Game ID, when applicable."
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "maxLength": 3
    },
    "schema_version": {
      "type": "integer",
      "default": 1,
      "minimum": 1
    },
    "reversal_of_entry_id": {
      "type": "string",
      "description": "If this entry reverses a prior entry, the ID of that entry"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description"
    }
  },
  "required": [
    "ledger_account",
    "transaction_type",
    "debit_amount",
    "credit_amount",
    "initiating_actor",
    "trigger_event",
    "ledger_group_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}