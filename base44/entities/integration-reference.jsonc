{
  "name": "IntegrationReference",
  "type": "object",
  "properties": {
    "provider_key": {
      "type": "string",
      "maxLength": 100,
      "description": "Stable adapter/provider identifier. Use unassigned until a partner is selected."
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "participant",
        "customer",
        "account",
        "wallet",
        "funding_source",
        "authorization",
        "payment",
        "transfer",
        "payout",
        "refund",
        "reversal",
        "dispute",
        "webhook_event",
        "other"
      ]
    },
    "external_reference_id": {
      "type": "string",
      "maxLength": 255,
      "description": "Opaque ID assigned by the selected external partner."
    },
    "internal_entity_type": {
      "type": "string",
      "enum": [
        "user",
        "wallet",
        "wallet_transaction",
        "match",
        "game",
        "dispute_case",
        "ledger_group",
        "integration_event"
      ]
    },
    "internal_entity_id": {
      "type": "string",
      "description": "Canonical Base44 ID mapped to the external reference."
    },
    "correlation_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 255
    },
    "user_id": {
      "type": "string"
    },
    "counterparty_user_id": {
      "type": "string"
    },
    "match_id": {
      "type": "string"
    },
    "game_id": {
      "type": "string"
    },
    "wallet_transaction_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "maxLength": 64
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata_json": {
      "type": "string",
      "maxLength": 8000,
      "description": "Sanitized adapter metadata only; never stores secrets, bank credentials, full payment instruments, or raw identity documents."
    }
  },
  "required": [
    "provider_key",
    "reference_type",
    "external_reference_id",
    "internal_entity_type",
    "internal_entity_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}