{
  "name": "CampaignRun",
  "type": "object",
  "properties": {
    "campaign_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "complete",
        "complete_with_failures"
      ],
      "default": "running"
    },
    "recipient_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "campaign_key",
    "status",
    "recipient_user_ids"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}